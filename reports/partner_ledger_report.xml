<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="ifrs18_partner_ledger_report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">Partner Ledger</h2>
                    <p class="text-center text-muted">
                        <span t-esc="docs.company_id.name"/> —
                        Period: <span t-esc="docs.date_from"/> to <span t-esc="docs.date_to"/>
                        <span t-if="docs.partner_id">— Partner: <span t-esc="docs.partner_id.name"/></span>
                    </p>
                    <t t-foreach="data.get('partners', [])" t-as="partner">
                        <h4><span t-esc="partner['name']"/></h4>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Reference</th>
                                    <th class="text-end">Debit</th>
                                    <th class="text-end">Credit</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="table-light">
                                    <td colspan="2"><strong>Opening Balance</strong></td>
                                    <td class="text-end" colspan="2"><span t-esc="partner['opening_balance']" t-options="{'widget': 'monetary', 'display_currency': docs.company_id.currency_id}"/></td>
                                </tr>
                                <t t-foreach="partner['transactions']" t-as="tx">
                                    <tr>
                                        <td><span t-esc="tx['date']"/></td>
                                        <td><span t-esc="tx['ref']"/></td>
                                        <td class="text-end"><span t-esc="tx['debit']" t-options="{'widget': 'monetary', 'display_currency': docs.company_id.currency_id}"/></td>
                                        <td class="text-end"><span t-esc="tx['credit']" t-options="{'widget': 'monetary', 'display_currency': docs.company_id.currency_id}"/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr class="table-dark">
                                    <th colspan="2">Closing Balance</th>
                                    <th class="text-end" colspan="2"><span t-esc="partner['closing_balance']" t-options="{'widget': 'monetary', 'display_currency': docs.company_id.currency_id}"/></th>
                                </tr>
                            </tfoot>
                        </table>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_ifrs18_partner_ledger" model="ir.actions.report">
        <field name="name">IFRS 18 Partner Ledger</field>
        <field name="model">ifrs18.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ifrs18_financial_reports.ifrs18_partner_ledger_report</field>
        <field name="report_file">ifrs18_financial_reports.ifrs18_partner_ledger_report</field>
        <field name="paperformat_id" ref="ifrs18_financial_reports.paperformat_ifrs18"/>
    </record>
</odoo>
