<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="ifrs18_changes_equity_report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">Statement of Changes in Equity</h2>
                    <p class="text-center text-muted">
                        <span t-esc="docs.company_id.name"/> —
                        Period: <span t-esc="docs.date_from"/> to <span t-esc="docs.date_to"/>
                    </p>
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="data.get('sections', {}).items()" t-as="section">
                                <tr class="table-active">
                                    <th colspan="2"><span t-esc="section[1]['label']"/></th>
                                </tr>
                                <t t-foreach="section[1]['lines']" t-as="line">
                                    <tr>
                                        <td style="padding-left: 20px;"><span t-esc="line.get('name', '')"/></td>
                                        <td class="text-end"><span t-esc="line.get('amount', 0)" t-options="{'widget': 'monetary', 'display_currency': docs.company_id.currency_id}"/></td>
                                    </tr>
                                </t>
                                <tr class="table-light">
                                    <th style="padding-left: 10px;">Subtotal</th>
                                    <th class="text-end"><span t-esc="section[1]['subtotal']" t-options="{'widget': 'monetary', 'display_currency': docs.company_id.currency_id}"/></th>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr class="table-dark">
                                <th>Closing Equity Balance</th>
                                <th class="text-end"><span t-esc="data['closing_balance']" t-options="{'widget': 'monetary', 'display_currency': docs.company_id.currency_id}"/></th>
                            </tr>
                        </tfoot>
                    </table>
                    <p class="text-muted small">Prepared in accordance with IFRS 18 presentation requirements.</p>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_ifrs18_changes_equity" model="ir.actions.report">
        <field name="name">IFRS 18 Changes in Equity</field>
        <field name="model">ifrs18.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ifrs18_financial_reports.ifrs18_changes_equity_report</field>
        <field name="report_file">ifrs18_financial_reports.ifrs18_changes_equity_report</field>
        <field name="paperformat_id" ref="ifrs18_financial_reports.paperformat_ifrs18"/>
    </record>
</odoo>
