<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="ifrs18_trial_balance_report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">Trial Balance</h2>
                    <p class="text-center text-muted">
                        <span t-esc="docs.company_id.name"/> —
                        Period: <span t-esc="docs.date_from"/> to <span t-esc="docs.date_to"/>
                    </p>
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Account</th>
                                <th class="text-end">Debit</th>
                                <th class="text-end">Credit</th>
                                <th class="text-end">Balance</th>
                                <th t-if="docs.comparison_date_from" class="text-end">Comp. Debit</th>
                                <th t-if="docs.comparison_date_from" class="text-end">Comp. Credit</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="data.get('lines', [])" t-as="line">
                                <tr>
                                    <td><span t-esc="line['code']"/></td>
                                    <td><span t-esc="line['name']"/></td>
                                    <td class="text-end"><span t-esc="line['debit']" t-options="{'widget': 'monetary', 'display_currency': docs.company_id.currency_id}"/></td>
                                    <td class="text-end"><span t-esc="line['credit']" t-options="{'widget': 'monetary', 'display_currency': docs.company_id.currency_id}"/></td>
                                    <td class="text-end"><span t-esc="line['balance']" t-options="{'widget': 'monetary', 'display_currency': docs.company_id.currency_id}"/></td>
                                    <td t-if="docs.comparison_date_from" class="text-end"><span t-esc="line['comparison_debit']" t-options="{'widget': 'monetary', 'display_currency': docs.company_id.currency_id}"/></td>
                                    <td t-if="docs.comparison_date_from" class="text-end"><span t-esc="line['comparison_credit']" t-options="{'widget': 'monetary', 'display_currency': docs.company_id.currency_id}"/></td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr class="table-dark">
                                <th colspan="2">Total</th>
                                <th class="text-end"><span t-esc="data['total_debit']" t-options="{'widget': 'monetary', 'display_currency': docs.company_id.currency_id}"/></th>
                                <th class="text-end"><span t-esc="data['total_credit']" t-options="{'widget': 'monetary', 'display_currency': docs.company_id.currency_id}"/></th>
                                <th class="text-end"><span t-esc="data['total_balance']" t-options="{'widget': 'monetary', 'display_currency': docs.company_id.currency_id}"/></th>
                                <th t-if="docs.comparison_date_from" class="text-end"><span t-esc="data['comparison_total_debit']" t-options="{'widget': 'monetary', 'display_currency': docs.company_id.currency_id}"/></th>
                                <th t-if="docs.comparison_date_from" class="text-end"><span t-esc="data['comparison_total_credit']" t-options="{'widget': 'monetary', 'display_currency': docs.company_id.currency_id}"/></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_ifrs18_trial_balance" model="ir.actions.report">
        <field name="name">IFRS 18 Trial Balance</field>
        <field name="model">ifrs18.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ifrs18_financial_reports.ifrs18_trial_balance_report</field>
        <field name="report_file">ifrs18_financial_reports.ifrs18_trial_balance_report</field>
        <field name="paperformat_id" ref="ifrs18_financial_reports.paperformat_ifrs18"/>
    </record>
</odoo>
